# Orbit App — environment template. Copy to `.env` and fill in real values.

# Supabase — same project as the Orbit web platform
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Sign-In (native account picker via the google_sign_in package).
# From Google Cloud Console → APIs & Services → Credentials.
#  - WEB client ID  → serverClientId; also add to Supabase Google provider's
#    "Authorized Client IDs".
#  - IOS client ID  → iOS only (blank for Android-only). Its reversed form also
#    goes in ios/Runner/Info.plist as a URL scheme.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=
